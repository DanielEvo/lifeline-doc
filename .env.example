# ── Supabase / Lovable Cloud (OBRIGATÓRIAS) ─────────────────────────────────
# Copie de Project Settings → Environment no workspace Lovable (ou do painel
# do Supabase: Project Settings → API).
#
# ATENÇÃO — estas NÃO são opcionais. As VITE_* são lidas pelo client Supabase
# (src/integrations/supabase/client.ts), que é acionado pelo middleware GLOBAL
# de server functions. Sem elas, o app ainda sobe, mas nenhuma chamada de
# server function completa — login, pacientes e prontuário param juntos.
# (Desde este commit o middleware degrada com elegância em vez de derrubar
# tudo, mas as telas que usam Postgres continuam precisando destas variáveis.)
#
# As chaves "publishable"/anon são públicas por definição (vão no bundle do
# navegador e são protegidas por RLS) — o segredo de verdade é só a
# SUPABASE_SERVICE_ROLE_KEY, que NUNCA deve ir para o client nem para o git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only (bypassa RLS) — usada por src/integrations/supabase/client.server.ts
# para agenda, critérios, documentos, publicações, leads, assinaturas, LOINC e
# biomarcadores. Nunca prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Login com Google (OAuth 2.0) ─────────────────────────────────────────────
# 1. Crie um projeto em https://console.cloud.google.com/apis/credentials
# 2. "Criar credenciais" → "ID do cliente OAuth" → tipo "Aplicativo da Web"
# 3. Em "URIs de redirecionamento autorizados", adicione as QUATRO — uma
#    credencial só, serve médico e paciente:
#      https://SEU-DOMINIO/auth/callback                  (médico · produção)
#      http://localhost:8080/auth/callback                (médico · dev)
#      https://SEU-DOMINIO/paciente/auth/callback         (paciente · produção)
#      http://localhost:8080/paciente/auth/callback       (paciente · dev)
# 4. Copie o ID e o segredo para cá.
#
# Sem estas variáveis o botão "Entrar com Google" usa um login simulado de
# desenvolvimento (persona Dra. Helena Costa / Mariana Silva) — nunca use
# assim em produção.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Gemini (OCR de exames, chat de conhecimento, templates e ditado) ─
# Única chave de IA usada pelo produto (TECH-24 — Lovable AI Gateway
# removido). Sem ela: OCR, assistente de conhecimento, criação de template
# por IA e ditado por voz ficam indisponíveis (erro claro, sem simulação).
GEMINI_API_KEY=

# ── Memed (prescrição digital real) ─────────────────────────────────────────
# 1. Peça acesso de parceiro em https://memed.com.br/parceiro-software/
# 2. No ambiente de homologação (compartilhado — par de chaves fixo e
#    público, ver HANDOVER_Memed_Referencia_Tecnica.md), copie API_KEY,
#    SECRET_KEY, API_URL e SCRIPT_URL abaixo.
# Sem elas: a "Receita digital" continua funcionando em modo local (código
# verificável próprio, sem embed do widget oficial da Memed).
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_API_URL=https://integrations.api.memed.com.br/v1
MEMED_SCRIPT_URL=https://integrations.memed.com.br/modulos/plataforma.sinapse-prescricao/build/sinapse-prescricao.min.js

# Ambiente ativo — "sandbox" (padrão) ou "live". Controla quais chaves abaixo
# são usadas, pra nunca emitir receita de teste com chave de produção.
MEMED_ENV=sandbox

# Chaves por ambiente (opcional) — quando presentes, têm prioridade sobre
# MEMED_API_KEY/MEMED_SECRET_KEY conforme MEMED_ENV. Útil pra manter as duas
# credenciais configuradas ao mesmo tempo (ex.: sandbox em dev, live em
# produção) sem trocar variável na mão a cada deploy.
MEMED_SANDBOX_API_KEY=
MEMED_SANDBOX_SECRET_KEY=
MEMED_LIVE_API_KEY=
MEMED_LIVE_SECRET_KEY=
# Em produção, a URL da API muda:
# MEMED_API_URL=https://api.memed.com.br/v1 (só depois da Autorização para
# Credenciais de Produção — ver §8 do handover).

# ── WhatsApp Business Cloud API (Meta) — envio automático ───────────────────
# 1. developers.facebook.com → seu app → WhatsApp → API Setup
# 2. Gere um token de usuário de sistema (permanente) e copie o
#    Phone Number ID de teste.
# Sem elas: os botões de WhatsApp continuam abrindo wa.me (envio manual) —
# isto só habilita o envio automático (ex.: lembrete de cobrança).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Stripe (link de pagamento — modo sandbox/teste) ─────────────────────────
# 1. dashboard.stripe.com → Developers → API keys → chave secreta de teste
#    (prefixo sk_test_). Nenhuma transação real é feita nesse modo.
# Sem ela: "Gerar link de pagamento" nas cobranças fica indisponível — o
# lembrete por WhatsApp segue funcionando sem o link.
STRIPE_SECRET_KEY=

# Chave do Lovable Cloud usada por src/lib/stripe.server.ts para autenticar no
# Stripe Connector Gateway (connector-gateway.lovable.dev/stripe) — infra de
# pagamento do Lovable Cloud, sem relação com o Lovable AI Gateway removido
# em TECH-24. Continua necessária mesmo com GEMINI_API_KEY configurada.
LOVABLE_API_KEY=

# ── Resend (e-mail transacional) ──────────────────────────────────────
# Crie conta em resend.com e gere uma API key. Sem domínio verificado,
# funciona em modo teste (remetente onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Resend (e-mail transacional) ──────────────────────────────────────
# Crie conta em resend.com e gere uma API key. Sem domínio verificado,
# funciona em modo teste (remetente onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
